{
  "name": "calories-diary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @calories-diary/shared build",
    "prepare": "husky",
    "dev": "node scripts/dev.mjs dev",
    "dev:https": "node scripts/dev.mjs dev:https",
    "dev:stop": "node scripts/ferma-dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @calories-diary/web lint",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @calories-diary/api migration:up",
    "db:seed": "pnpm --filter @calories-diary/api seed",
    "db:seed:demo": "pnpm --filter @calories-diary/api seed:demo",
    "utente:crea": "pnpm --filter @calories-diary/api utente:crea"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
