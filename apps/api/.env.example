# Copy to .env for local development. Values below match docker-compose.yml.

# development | test | production
NODE_ENV=development
PORT=3001

# App connection. In production: Neon *pooled* connection string.
DATABASE_URL=postgres://calories:calories@localhost:5432/calories_diary
# Migrations only. In production: Neon *direct* connection string. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# redis:// locally, rediss:// (TLS) on Upstash.
REDIS_URL=redis://localhost:6379
# Key prefix per environment, e.g. calories-diary:prod:
REDIS_PREFIX=calories-diary:dev:

# Comma-separated allowed origins; "*" matches any characters (e.g. https://calories-diary-*.vercel.app).
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Key that signs the session tokens (min 32 characters). Generate it with: openssl rand -base64 48
# Changing it logs out every user.
JWT_SECRET=

# Shown by /health. Set by the Docker build (git sha); "dev" if missing.
APP_VERSION=
